#!/usr/bin/env bash
# bin/sync — the skills are docs on menger; the files here are the same bodies.
#
#   bin/sync status   which files differ from their docs
#   bin/sync push     amend every doc from its file (the file wins)
#   bin/sync pull     write every file from its doc (the tracker wins)
#   bin/sync create   file the docs that do not exist yet, in skills.tsv order
#
# skills.tsv: id <TAB> file <TAB> parent <TAB> title. Needs synapse and jq;
# PORT (default 4455) picks the environment. A doc's kind is doc, so it has
# no lifecycle; a refusal names its reason in band and writes nothing.
set -euo pipefail
cd "$(dirname "$0")/.."
PORT="${PORT:-4455}"
m() { synapse -P "$PORT" -j menger "$@"; }
body_of() { m tickets get --id "$1" | jq -r 'select(.content.ticket) | .content.ticket.body'; }
exists() { m tickets get --id "$1" | jq -e 'select(.content.ticket) | .content.ticket.id' >/dev/null 2>&1; }

cmd="${1:-status}"
while IFS=$'\t' read -r id file parent title; do
  [ -n "$id" ] || continue
  case "$cmd" in
    status)
      if ! exists "$id"; then echo "missing  $id  $file"; continue; fi
      if diff -q <(body_of "$id") "$file" >/dev/null; then echo "same     $id  $file"; else echo "differs  $id  $file"; fi ;;
    push)
      if diff -q <(body_of "$id") "$file" >/dev/null; then echo "same     $id"; continue; fi
      m tickets amend --id "$id" --title "$title" --body "$(cat "$file")" \
        | jq -r --arg id "$id" 'if .content.changed then "amended  \($id)  \(.content.changed | join(","))" elif .content.message then "REFUSED  \($id)  \(.content.message)" else empty end' ;;
    pull)
      body_of "$id" > "$file.tmp" && mv "$file.tmp" "$file" && echo "pulled   $id  $file" ;;
    create)
      if exists "$id"; then echo "exists   $id"; continue; fi
      got=$(m tickets create --epic "${id%%-*}" --kind doc --parent "$parent" --title "$title" --body "$(cat "$file")" \
        | jq -r 'if .content.ticket then .content.ticket.id elif .content.message then "REFUSED: " + .content.message else empty end')
      if [ "$got" = "$id" ]; then echo "created  $id  $file"; else echo "MISMATCH expected $id got $got for $file"; exit 1; fi ;;
    *) echo "usage: bin/sync status|push|pull|create" >&2; exit 2 ;;
  esac
done < skills.tsv
